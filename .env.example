# Salin file ini jadi .env.local, lalu isi dari Supabase Dashboard.
# .env.local TIDAK ikut ke git (lihat .gitignore).

# Supabase -> Project Settings -> API Keys
# Pakai key PUBLISHABLE (berawalan `sb_publishable_`). Itu format baru Supabase,
# pengganti anon key lama yang berbentuk JWT `eyJ...`; keduanya masih jalan.
# Aman ikut ter-bundle di JS — RLS yang menjaga data, bukan kerahasiaan key.
# JANGAN pakai key `sb_secret_` di sini.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# VAPID public key untuk Web Push.
# Dihasilkan lewat:  npx web-push generate-vapid-keys
# Aman ikut ter-bundle di JS — key ini memang dirancang publik.
# PRIVATE key-nya JANGAN ditaruh di sini. Simpan sebagai secret Edge Function
# (Dashboard -> Edge Functions -> Secrets), bersama VAPID_SUBJECT, CRON_SECRET,
# dan RESEND_API_KEY. Lihat bagian "Pengingat" di README.
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Khusus untuk `npm run seed` (dijalankan dari komputer, bukan dari browser).
# Service role key MELEWATI RLS — jangan pernah dipakai di kode client.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Email user yang datanya di-seed (harus sudah dibuat di Supabase Auth).
SEED_OWNER_EMAIL=
